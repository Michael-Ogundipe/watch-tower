# Per-instance credentials. Copy this file to .env.local or .env.vps,
# set INSTANCE_ID and DATA_DIR, then launch with INSTANCE_ID=local or vps.

INSTANCE_ID=
DATA_DIR=

# Deriv application id (from https://app.deriv.com/account/api-token)
DERIV_APP_ID=

# Deriv API token with trading scope for the account below
DERIV_API_TOKEN=

# The DEMO account to trade, e.g. VRTC1234567
DERIV_DEMO_ACCOUNT_ID=

# Optional: override the watched symbols (comma separated)
# WATCHTOWER_SYMBOLS=JD75,JD25,R_75

# Execution protections (spread is measured in raw quote-price units, not pips).
WATCHTOWER_MAX_ENTRY_SPREAD=1.0
WATCHTOWER_BREAKEVEN_ENABLED=true
WATCHTOWER_BREAKEVEN_TRIGGER_R=1.5
WATCHTOWER_STRUCTURAL_TRAILING_ENABLED=false
WATCHTOWER_MIN_ENTRY_RR=1.0
